# Full reference of NG_ configuration variables (see src/common/config/app_config.py).
# Every variable has a sane default in code — this file documents them, it is not required.
# For the minimal network wiring, use .env.example instead.

# --- Neo4j (graph store) ---
NG_NEO4J_URI=bolt://localhost:7687
NG_NEO4J_USER=neo4j
NG_NEO4J_PASSWORD=normgraph
NG_NEO4J_DATABASE=neo4j
NG_RESTRICTION_VECTOR_INDEX=restriction_embedding
NG_CLAUSE_VECTOR_INDEX=clause_embedding

# --- IDU_DVD (source of documents, clauses and references) ---
NG_DVD_BASE_URL=http://localhost:8100
NG_DVD_TIMEOUT=120.0
NG_DVD_SEARCH_FALLBACK=true

# --- LLM provider (openai_compatible | ollama) ---
NG_LLM_PROVIDER=openai_compatible
NG_LLM_BASE_URL=http://localhost:11434/v1
NG_LLM_MODEL=qwen2.5:7b-instruct
# NG_LLM_API_KEY=
NG_LLM_TEMPERATURE=0.0
NG_LLM_MAX_TOKENS=4096
NG_LLM_TIMEOUT=600.0
NG_OLLAMA_BASE=http://localhost:11434

# --- Embeddings provider (openai_compatible | ollama) ---
NG_EMBEDDINGS_PROVIDER=openai_compatible
NG_EMBEDDINGS_URL=http://localhost:8001
NG_EMBEDDINGS_MODEL=ai-sage/Giga-Embeddings-instruct
# NG_EMBEDDINGS_API_KEY=
NG_EMBEDDINGS_QUERY_PROMPT=Instruct: Дан вопрос, необходимо найти ограничение с ответом\nQuery:
NG_EMBEDDINGS_TIMEOUT=600.0
NG_VECTOR_SIZE=2048
NG_EMBED_BATCH=32

# --- Extraction pipeline ---
NG_EXTRACTION_PASSES=1
NG_ENTITY_MERGE_THRESHOLD=0.90
NG_KIND_MATCH_THRESHOLD=0.88
NG_EXTRACT_CONCURRENCY=8

# --- Search / graph traversal ---
NG_SEARCH_LIMIT=10
NG_MAX_TRAVERSAL_DEPTH=3

# --- Kafka (incremental sync from IDU_DVD document.events) ---
# NG_KAFKA_BOOTSTRAP_SERVERS=next.idulab.ru:9192,next.idulab.ru:9193,next.idulab.ru:9194
NG_KAFKA_SCHEMA_REGISTRY_URL=https://schema-registry.next.idulab.ru
NG_KAFKA_CLIENT_ID=normgraph
NG_KAFKA_GROUP_ID=normgraph-sync
NG_KAFKA_TOPIC=document.events
NG_KAFKA_AUTO_OFFSET_RESET=earliest
NG_RECONCILE_ON_STARTUP=true

# --- Logging ---
NG_LOG_DIR=./logs
NG_LOG_FILE=app.log
NG_LOG_LEVEL=INFO
