# Network wiring of the service: addresses of the external components NormGraph
# connects to — Neo4j, IDU_DVD, the LLM provider, the embeddings service, Kafka.
# Everything else has sane defaults in src/common/config/app_config.py, so the
# app starts without a .env. Full reference: .env.full.example and docs/*/configuration.md.
#
# Copy to .env and adjust:  cp .env.example .env

# --- Neo4j (graph store; local infra: make up) ---
# In docker compose this is overridden to the compose service name (bolt://neo4j:7687).
NG_NEO4J_URI=bolt://localhost:7687
NG_NEO4J_USER=neo4j
NG_NEO4J_PASSWORD=normgraph

# --- IDU_DVD (source of documents, clauses and references) ---
# Prod DVD publishes on 8100 (DVD_HOST_PORT); locally it may be 8000.
NG_DVD_BASE_URL=http://localhost:8100

# --- LLM provider (restriction extraction via langextract + aux tasks) ---
# Default provider is OpenAI-compatible (vLLM / LM Studio / llama.cpp / Ollama /v1 / ...).
# NG_LLM_BASE_URL must point at the OpenAI-compatible root (…/v1).
NG_LLM_PROVIDER=openai_compatible
NG_LLM_BASE_URL=http://localhost:11434/v1
NG_LLM_MODEL=qwen2.5:7b-instruct
NG_EXTRACT_CONCURRENCY=8
# NG_LLM_API_KEY=

# --- Embeddings (default: Giga-Embeddings-instruct via OpenAI-compatible /v1/embeddings) ---
NG_EMBEDDINGS_PROVIDER=openai_compatible
NG_EMBEDDINGS_URL=http://localhost:8001
NG_EMBEDDINGS_MODEL=ai-sage/Giga-Embeddings-instruct
NG_VECTOR_SIZE=2048

# --- Kafka (incremental sync from IDU_DVD document.events) ---
# Consumption is disabled until a broker is set (empty value = disabled).
# NG_KAFKA_BOOTSTRAP_SERVERS=next.idulab.ru:9192,next.idulab.ru:9193,next.idulab.ru:9194
# Schema Registry of the contour is already the default in code:
# NG_KAFKA_SCHEMA_REGISTRY_URL=https://schema-registry.next.idulab.ru
NG_SERVICE_AUTH_SERVER_URL=https://keycloak.example.com
NG_SERVICE_AUTH_REALM=IDU
NG_SERVICE_AUTH_CLIENT_ID=normgraph
NG_SERVICE_AUTH_CLIENT_SECRET=change-me
